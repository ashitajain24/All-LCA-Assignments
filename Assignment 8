#include <stdio.h>

int main()
{
    int a, b, temp;
    int *p1, *p2;

    printf("Enter the first number: ");
    scanf("%d", &a);

    printf("Enter the second number: ");
    scanf("%d", &b);

    p1 = &a;
    p2 = &b;

    printf("\nBefore Swapping:\n");
    printf("First number = %d, Second number = %d\n", a, b);

    temp = *p1;
    *p1 = *p2;
    *p2 = temp;

    printf("\nAfter Swapping:\n");
    printf("First number = %d, Second number = %d\n", a, b);

    return 0;
}
