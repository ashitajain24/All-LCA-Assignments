#include <stdio.h>

// Function without recursion
int factorial_iterative(int n)
{
    int fact = 1;
    for (int i = 1; i <= n; i++)
    {
        fact = fact * i;
    }
    return fact;
}

// Function with recursion
int factorial_recursive(int n)
{
    if (n == 0 || n == 1)
        return 1;
    else
        return n * factorial_recursive(n - 1);
}

int main()
{
    int n;

    printf("Enter a number: ");
    scanf("%d", &n);

    printf("Factorial without recursion = %d\n", factorial_iterative(n));
    printf("Factorial with recursion = %d\n", factorial_recursive(n));

    return 0;
}
